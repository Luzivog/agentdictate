# AgentDictate reads keyboard events for its global shortcut and writes
# uinput itself for paste delivery. Access follows the active local logind
# session instead of granting persistent access to every local user.
ACTION!="remove", SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_KEYBOARD}=="1", MODE="0660", TAG+="uaccess"
# AgentDictate's own virtual devices (its paste keyboard and test keyboards)
# are readable by the session that can already create them through uinput.
ACTION!="remove", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="AgentDictate *", MODE="0660", TAG+="uaccess"
ACTION!="remove", SUBSYSTEM=="misc", KERNEL=="uinput", MODE="0660", TAG+="uaccess", OPTIONS+="static_node=uinput"
